# Copy to `.env` for local development: `cp .env.example .env`
# `.env` is git-ignored. Never commit real credentials. Production configuration comes from the
# deployment environment, never from files.

# --- api ---------------------------------------------------------------------------------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
# Matches infra/docker/compose.yml (local development credentials only).
DATABASE_URL=postgres://jordan_sports:jordan_sports@127.0.0.1:5432/jordan_sports
DATABASE_POOL_MAX=10

# --- web ---------------------------------------------------------------------------------
# Absolute base URL used for canonical/hreflang links.
WEB_BASE_URL=http://localhost:3000
# Support WhatsApp number for the /contact page, in international format. Placeholder — the
# contact page marks it as unconfirmed until this is set to a real support line.
SUPPORT_WHATSAPP=+962700000000

# Redis (rate limiting). Matches infra/docker/compose.yml.
REDIS_URL=redis://127.0.0.1:6379
# At least 32 random characters. Development value only — generate a new one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=dev-only-insecure-auth-secret-change-me-0000
# Origins allowed to make state-changing requests (comma-separated).
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Development only: sign-in codes are printed to the API log. Refused in production.
OTP_CHANNEL=console
# Where the API reaches from the Next.js servers (same-site /api proxy).
API_INTERNAL_URL=http://127.0.0.1:4000
