# Copy to `.env` for local development: `cp .env.example .env`
# `.env` is git-ignored. Never commit real credentials. Production configuration comes from the
# deployment environment, never from files.

# --- api ---------------------------------------------------------------------------------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
# Matches infra/docker/compose.yml (local development credentials only).
DATABASE_URL=postgres://jordan_sports:jordan_sports@127.0.0.1:5432/jordan_sports
DATABASE_POOL_MAX=10

# --- web ---------------------------------------------------------------------------------
# Absolute base URL used for canonical/hreflang links.
WEB_BASE_URL=http://localhost:3000
