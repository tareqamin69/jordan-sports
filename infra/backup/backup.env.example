# Copy to /opt/jordan-sports/backup.env on the server (mode 600). Never commit a filled copy.
# Where backups go: an rclone remote:path you configured on the server (`rclone config`), e.g. a
# Hetzner Storage Box (sftp), Backblaze B2 or any S3-compatible bucket, in a DIFFERENT provider
# or account from the server if you can.
BACKUP_REMOTE=offsite:jorena-backups
RCLONE_CONFIG=/opt/jordan-sports/rclone.conf
# PUBLIC age key (starts with age1...). The matching PRIVATE key is never on the server.
BACKUP_AGE_RECIPIENT=age1replacewithyourpublickey
# Keep every backup younger than this many days, and always at least the newest KEEP_MIN.
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_MIN=7
# Optional dead-man's switch (healthchecks.io etc.): you get an alert when pings stop arriving.
BACKUP_PING_URL=
