{
  "$comment": "Search queries per sport for fallback photos (Pexels only: free for commercial use, no hotlinking needed). Queries ask for empty courts/fields to avoid recognizable faces and brand logos. Add a photo id to 'exclude' to drop it on the next run (node dist/cli/stock-photos.js --refresh). See docs/image-credits.md.",
  "perSport": 4,
  "sports": {
    "football": {
      "queries": ["empty football pitch grass", "football stadium field night lights"]
    },
    "futsal": { "queries": ["indoor futsal court", "indoor soccer court empty"] },
    "padel": { "queries": ["padel court", "empty padel court"] },
    "tennis": { "queries": ["empty tennis court", "tennis court aerial"] },
    "basketball": { "queries": ["empty basketball court", "indoor basketball court"] },
    "volleyball": { "queries": ["indoor volleyball court", "volleyball net gym"] },
    "beach_volleyball": { "queries": ["beach volleyball net sand", "beach volleyball court"] },
    "squash": { "queries": ["squash court", "squash racket ball court"] },
    "badminton": { "queries": ["badminton court", "badminton shuttlecock net"] },
    "table_tennis": { "queries": ["table tennis table", "ping pong table"] },
    "billiards": { "queries": ["billiard table", "pool table balls"] },
    "swimming": { "queries": ["swimming pool lanes", "empty swimming pool lanes"] },
    "gym": { "queries": ["empty gym equipment", "gym weights rack"] },
    "bowling": { "queries": ["bowling alley lanes", "bowling pins lane"] },
    "handball": { "queries": ["indoor handball court", "sports hall court empty"] },
    "martial_arts": { "queries": ["martial arts dojo mat", "boxing ring empty"] },
    "running_track": { "queries": ["running track stadium", "athletics track lanes"] }
  },
  "fallbackQueries": ["sports court empty", "sports field"],
  "exclude": []
}
