{
  "name": "@jordan-sports/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.http.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "node dist/platform/database/cli.js migrate",
    "db:status": "node dist/platform/database/cli.js status"
  },
  "dependencies": {
    "@jordan-sports/contracts": "workspace:*",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-fastify": "12.1.0",
    "fastify": "^5.12.5",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@jordan-sports/config": "workspace:*",
    "@nestjs/cli": "12.0.7",
    "@nestjs/testing": "12.1.0",
    "@swc/core": "1.16.2",
    "@types/node": "^22.20.4",
    "@types/pg": "8.23.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}
