{
  "name": "@jordan-sports/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/gen-web.mjs --check",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:web": "node scripts/gen-web.mjs",
    "check:web": "node scripts/gen-web.mjs --check"
  },
  "dependencies": {
    "@jordan-sports/brand": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@jordan-sports/config": "workspace:*",
    "@types/node": "^22.20.4",
    "typescript": "~6.0.3",
    "vitest": "5.0.2"
  }
}
